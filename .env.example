# Copy this file to .env and fill in the values. .env is git-ignored.

# Client (Create React App) - baked into the build, so never put secrets here.
REACT_APP_BACKEND_URL=http://localhost:5000

# Server-only. The POST /api/execute route proxies to Judge0 with these.
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here

# Server-only. Neon Postgres pooled connection string (host contains "-pooler").
# Optional - leave unset to run without persistence (rooms/run history won't be saved).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
